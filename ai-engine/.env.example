AI_PROVIDER=groq

GROQ_API_KEY=
# Model teks Groq; ganti kalau Groq memensiunkan model.
GROQ_MODEL=openai/gpt-oss-120b
# Dipakai untuk CV berformat foto (vision).
GEMINI_API_KEY=

# Shared secret yang dikirim backend Go lewat header X-Internal-Api-Key.
# Servis ini cuma dipanggil server-to-server, gak pernah dari browser.
INTERNAL_API_KEY=
