# Wajib minimal 16 karakter di server sungguhan (PINTUKARIER_ENV=production menolak start tanpa ini).
PINTUKARIER_SECRET=
PINTUKARIER_ENV=development
PORT=8080

DATABASE_URL=postgres://pintukarier:pintukarier_dev_password@localhost:5433/pintukarier?sslmode=disable

# AI Engine internal; INTERNAL_API_KEY harus sama dengan ai-engine/.env.
AI_ENGINE_URL=http://localhost:8000
INTERNAL_API_KEY=
# Batas panggilan paralel ke AI Engine (rate limiting sisi backend).
AI_CONCURRENCY=4

# Alamat backend yang dibuka browser (untuk link upload bertanda tangan) dan origin frontend (CORS upload).
PUBLIC_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3000
STORAGE_DIR=./data/files

# Isi data demo fiktif sekali saat start. Akun demo WAJIB diisi lewat env, tidak ada nilai bawaan di kode.
PINTUKARIER_SEED_DEMO=0
DEMO_MAHASISWA_EMAIL=
DEMO_MAHASISWA_PASSWORD=
DEMO_MAHASISWA_NAMA=
DEMO_HRD_EMAIL=
DEMO_HRD_PASSWORD=
DEMO_HRD_NAMA=
DEMO_PRODI_EMAIL=
DEMO_PRODI_PASSWORD=
DEMO_PRODI_NAMA=

# Seed akun produksi (masing-masing 1 akun per role: admin, hrd, prodi, mahasiswa) tanpa data fiktif.
# Set PINTUKARIER_SEED_PROD=1 untuk otomatisasi saat container start, atau jalankan: go run ./cmd/seed
PINTUKARIER_SEED_PROD=0
PROD_ADMIN_EMAIL=admin@pintukarier.id
PROD_ADMIN_PASSWORD=
PROD_ADMIN_NAMA=Administrator Pintu Karier
PROD_ADMIN_INSTANSI=Pintu Karier

PROD_HRD_EMAIL=hrd@mitra.pintukarier.id
PROD_HRD_PASSWORD=
PROD_HRD_NAMA=HRD Mitra Industri
PROD_HRD_INSTANSI=PT Mitra Industri

PROD_PRODI_EMAIL=prodi@kampus.ac.id
PROD_PRODI_PASSWORD=
PROD_PRODI_NAMA=Koordinator Prodi Vokasi
PROD_PRODI_INSTANSI=D4 Teknik Informatika

PROD_MAHASISWA_EMAIL=mahasiswa@kampus.ac.id
PROD_MAHASISWA_PASSWORD=
PROD_MAHASISWA_NAMA=Mahasiswa Pintu Karier
PROD_MAHASISWA_INSTANSI=D4 Teknik Informatika
PROD_MAHASISWA_NIM=2104411001
PROD_MAHASISWA_KAMPUS=Politeknik Negeri
PROD_MAHASISWA_SEMESTER=7
PROD_MAHASISWA_IPK=3.85

# Hanya untuk go test integrasi: tiap tes membuat lalu menghapus database sementara di server ini.
PINTUKARIER_TEST_DATABASE_URL=
